# Primary generation provider: openrouter (default), gemini, or ollama.
LLM_PROVIDER=openrouter

# OpenRouter API key (required when LLM_PROVIDER=openrouter)
# Obtain your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_API_KEY_HERE

# Model selection for OpenRouter (defaults to meta-llama/llama-3.3-70b-instruct if left blank)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# OpenRouter API Base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google AI Studio API key (used when LLM_PROVIDER=gemini)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=PASTE_YOUR_GOOGLE_AI_STUDIO_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Ollama local configuration (used when LLM_PROVIDER=ollama; needs no external key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
